# Neon Postgres - pooled connection (for the app)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# Neon Postgres - direct connection (for Prisma migrations)
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# iron-session secret (required, must be at least 32 characters)
SESSION_SECRET="replace-with-a-strong-random-string-of-32+-characters"
